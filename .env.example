# ─── .env.example ────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values before running tests.
#
#   cp .env.example .env
#
# NEVER commit .env to version control — it is already listed in .gitignore.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application under test ───────────────────────────────────────────────────
BASE_URL=https://github.com

# ── GitHub credentials (required for login / authenticated tests) ─────────────
GITHUB_USERNAME=your_github_username
GITHUB_PASSWORD=your_github_password

# ── Playwright execution settings ────────────────────────────────────────────
# Run browsers without a UI (set to 'false' for local debugging)
HEADLESS=true

# Target browser: chromium | firefox | webkit
BROWSER=chromium

# Global test timeout in milliseconds
TIMEOUT=30000

# ── Optional: GitHub Personal Access Token ───────────────────────────────────
# Required for any test that calls the GitHub REST API directly.
# Generate one at https://github.com/settings/tokens (classic, repo + user scopes)
GITHUB_TOKEN=your_personal_access_token

# ── Optional: test-data Excel file path ──────────────────────────────────────
# Relative path used by ExcelUtils; defaults to test-data/testdata.xlsx
TEST_DATA_FILE=test-data/testdata.xlsx
