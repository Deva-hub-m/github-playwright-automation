{
  "name": "github-playwright-automation",
  "version": "1.0.0",
  "description": "Playwright JavaScript automation framework for GitHub web application",
  "main": "index.js",
  "type": "commonjs",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "test:report": "playwright show-report",
    "test:report:open": "start test-results/reports && dir test-results\\reports"
  },
  "keywords": [
    "playwright",
    "automation",
    "javascript",
    "page-object-model",
    "github"
  ],
  "author": "Deva Vignan",
  "license": "ISC",
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.2",
    "dotenv": "^16.4.7",
    "xlsx": "^0.18.5"
  }
}
